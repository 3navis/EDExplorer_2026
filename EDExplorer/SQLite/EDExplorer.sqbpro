from Sistema
where (rOUND(POSx,2), Round(posY,2), Round(posZ,2)) in (
	SELECT rOUND(POSx,2), Round(posY,2), Round(posZ,2)
	FROM SISTEMA
	GROUP BY rOUND(POSx,2), Round(posY,2), Round(posZ,2)
	having count(1) &gt; 1)
order by 6,7,8</sql><sql name="mas lejanos.sql">select *, (posx*posx+posy*posy+posz*posz) dd
from Sistema
order by (posx*posx+posy*posy+posz*posz) desc</sql><current_tab id="0"/></tab_sql></sqlb_project>
